# AI Radar - konfigurace. Zkopiruj na .env.local a doplnte hodnoty.
# .env.local NIKDY necommituj.

# YouTube Data API v3 (jen pro preklad @handle -> Channel ID). Nepovinne.
YOUTUBE_API_KEY=

# Google Gemini API (analyza videi). Nepovinne - bez nej je aplikace plne pouzitelna
# pro RSS synchronizaci, filtry, knihovnu i export.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Cloud Translation API (preklad nazvu videi). Nepovinne - bez nej zustava original.
GOOGLE_TRANSLATE_API_KEY=

# Volitelne: cesta k SQLite databazi (default: ./data/ai-radar.db)
# AI_RADAR_DB_PATH=

# Volitelne: hostitele, kteri smi menit data i bez tokenu (napr. LAN nebo Tailscale).
# Prohlizec token sam neposle, proto se pro pristup z LAN uvadi tady. Oddeluje se carkou.
# Priklad: AI_RADAR_ALLOWED_HOSTS=192.168.3.241,100.86.138.22
# AI_RADAR_ALLOWED_HOSTS=

# Volitelne: ochrana mutujicich endpointu, pokud aplikace bezi mimo localhost.
# Kdyz je nastaveny, vyzaduje se hlavicka x-ai-radar-token u VSECH mutaci (i z localhostu).
# AI_RADAR_ACCESS_TOKEN=
